{
  "name": "plandev-ui",
  "description": "The client application for PlanDev.",
  "version": "4.2.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NASA-AMMOS/plandev-ui.git"
  },
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "build": "rm -rf build && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cloc": "cloc src",
    "dev": "npm run version && vite dev --port 3000",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint --ignore-path .gitignore .",
    "lint:css": "stylelint **/*.{css,svelte}",
    "lint:css:fix": "stylelint **/*.{css,svelte} --fix",
    "prebuild": "npm run version",
    "predev": "node ./scripts/check-node.cjs",
    "preview": "vite preview --port 3000",
    "sync": "svelte-kit sync",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:clear-cache": "rm -rf .playwright",
    "test:e2e:codegen": "playwright codegen http://localhost:3000",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:with-ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "version": "node ./scripts/version.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.19.1",
    "@codemirror/lang-json": "6.0.1",
    "@codemirror/language": "6.11.0",
    "@codemirror/lint": "6.8.5",
    "@codemirror/view": "6.38.2",
    "@fontsource/jetbrains-mono": "5.2.5",
    "@lezer/common": "1.2.3",
    "@lezer/generator": "1.7.3",
    "@lezer/highlight": "1.2.1",
    "@lezer/lr": "1.4.2",
    "@nasa-jpl/aerie-actions": "1.2.4",
    "@nasa-jpl/aerie-ampcs": "1.0.6",
    "@nasa-jpl/aerie-sequence-languages": "1.0.2",
    "@nasa-jpl/seq-json-schema": "1.3.1",
    "@nasa-jpl/stellar": "2.0.0-alpha.30",
    "@nasa-jpl/stellar-svelte": "2.1.10",
    "@neodrag/svelte": "2.3.2",
    "@streamparser/json": "0.0.17",
    "@sveltejs/adapter-node": "5.0.1",
    "@sveltejs/kit": "2.50.2",
    "@tanstack/svelte-virtual": "3.13.6",
    "ag-grid-community": "32.2.0",
    "ajv": "8.17.1",
    "codemirror": "6.0.1",
    "cookie": "0.6.0",
    "d3-array": "3.2.4",
    "d3-axis": "3.0.0",
    "d3-brush": "3.0.0",
    "d3-drag": "3.0.0",
    "d3-format": "3.1.0",
    "d3-quadtree": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-scale-chromatic": "3.1.0",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-time": "3.1.0",
    "d3-zoom": "3.0.0",
    "dompurify": "3.4.10",
    "fastest-levenshtein": "1.0.16",
    "graphql-ws": "5.16.2",
    "json-source-map": "0.6.1",
    "jszip": "3.10.1",
    "jwt-decode": "4.0.0",
    "lodash-es": "4.17.23",
    "marked": "18.0.5",
    "monaco-editor": "0.47.0",
    "postgres-interval": "4.0.2",
    "split-grid": "1.0.11",
    "svelte": "4.2.19",
    "svelte-dnd-action": "0.9.60",
    "svelte-popperjs": "1.3.2",
    "svelte-preprocess": "5.1.4",
    "tippy.js": "6.3.7",
    "toastify-js": "1.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@poppanator/sveltekit-svg": "4.2.1",
    "@sveltejs/vite-plugin-svelte": "3.1.2",
    "@testing-library/svelte": "4.2.3",
    "@types/cookie": "0.6.0",
    "@types/d3-array": "3.2.1",
    "@types/d3-axis": "3.0.6",
    "@types/d3-brush": "3.0.6",
    "@types/d3-drag": "3.0.7",
    "@types/d3-format": "3.0.4",
    "@types/d3-quadtree": "3.0.6",
    "@types/d3-scale": "4.0.9",
    "@types/d3-scale-chromatic": "3.1.0",
    "@types/d3-selection": "3.0.11",
    "@types/d3-shape": "3.1.7",
    "@types/d3-time": "3.0.4",
    "@types/d3-zoom": "3.0.8",
    "@types/lodash-es": "4.17.12",
    "@types/node": "20.17.30",
    "@types/picomatch": "2.3.4",
    "@types/toastify-js": "1.12.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "@vitest/coverage-v8": "1.6.1",
    "@vitest/ui": "1.6.1",
    "autoprefixer": "10.4.21",
    "cloc": "2.0.0-cloc",
    "esbuild": "0.24.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-svelte": "2.46.1",
    "eslint-plugin-tailwindcss": "3.18.0",
    "jsdom": "24.1.3",
    "picocolors": "1.1.1",
    "picomatch": "4.0.2",
    "postcss": "8.5.3",
    "postcss-html": "1.8.0",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "3.3.3",
    "prettier-plugin-tailwindcss": "0.7.2",
    "semver": "7.7.1",
    "stylelint": "16.18.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-order": "6.0.4",
    "svelte-check": "3.8.6",
    "svgo": "4.0.0",
    "tailwindcss": "3.4.17",
    "tslib": "2.8.1",
    "typescript": "5.7.3",
    "unique-names-generator": "4.7.1",
    "vite": "5.4.8",
    "vitest": "1.6.1"
  },
  "//": "remove this override when vite updates esbuild dependency to 0.24",
  "overrides": {
    "vite": {
      "esbuild": "0.24.2"
    }
  }
}
